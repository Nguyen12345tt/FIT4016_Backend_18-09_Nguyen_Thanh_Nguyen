@model OrderManagementApp.Order

@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Order Number</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.OrderNumber)</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerName)</dd>

        <dt class="col-sm-3">Product</dt>
        <dd class="col-sm-9">@(Model.Product != null ? Model.Product.Name : "")</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantity)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>