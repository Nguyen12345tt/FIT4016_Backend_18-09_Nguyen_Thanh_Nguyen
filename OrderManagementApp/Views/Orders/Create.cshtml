@model OrderManagementApp.Order
@{
    ViewData["Title"] = "Create Order";
}

<h1>Create Order</h1>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label>Product</label>
        <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
    </div>

    <div class="form-group mb-3">
        <label>Order Number (ORD-YYYYMMDD-XXXX)</label>
        <input asp-for="OrderNumber" class="form-control" />
        <span asp-validation-for="OrderNumber" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Customer Name</label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Email</label>
        <input asp-for="CustomerEmail" class="form-control" type="email" />
        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Quantity</label>
        <input asp-for="Quantity" class="form-control" type="number" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Order Date</label>
        <input asp-for="OrderDate" class="form-control" type="date" />
        <span asp-validation-for="OrderDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Delivery Date (Optional)</label>
        <input asp-for="DeliveryDate" class="form-control" type="date" />
        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}